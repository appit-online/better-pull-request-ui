{
  "name": "PullRequests",
  "version": "2.0.0",
  "main": "dist/index.js",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "build-electron": "NODE_OPTIONS=--openssl-legacy-provider ng build --base-href . && cp src/electron/* dist/ && cd dist && npm install --production && cd ..",
    "electron": "npm run build-electron && NODE_OPTIONS= ./node_modules/.bin/electron dist/",
    "make": "npm run build-electron && electron-builder --dir",
    "publish": "npm run build-electron && electron-builder --publish always"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^11.2.3",
    "@angular/common": "~11.2.3",
    "@angular/compiler": "~11.2.3",
    "@angular/core": "~11.2.3",
    "@angular/forms": "~11.2.3",
    "@angular/platform-browser": "~11.2.3",
    "@angular/platform-browser-dynamic": "~11.2.3",
    "@angular/router": "~11.2.3",
    "@octokit/core": "^3.2.5",
    "bootstrap": "^4.6.0",
    "electron-json-storage": "^4.4.0",
    "electron-squirrel-startup": "^1.0.0",
    "ngx-toastr": "^13.2.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1102.2",
    "@angular/cli": "~11.2.2",
    "@angular/compiler-cli": "~11.2.3",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "codelyzer": "^6.0.0",
    "electron": "^11.3.0",
    "electron-builder": "^24.13.3",
    "electron-icon-maker": "0.0.5",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.1.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "postcss": "^8.5.31",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~4.1.2"
  },
  "build": {
    "appId": "de.appit.review-hub",
    "productName": "Review Hub",
    "directories": {
      "buildResources": "buildResources",
      "app": "dist",
      "output": "out"
    },
    "mac": {
      "icon": "buildResources/icons/mac/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "appit-online",
      "repo": "better-pull-request-ui",
      "releaseType": "release",
      "publishAutoUpdate": false
    }
  }
}
